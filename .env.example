# ============================================================
# backendTesis — variables para correr la API en local con uvicorn.
# Copiar a .env (pydantic-settings lo lee desde la raíz del repo).
# Los servicios de datos salen de infraTesis/docker-compose.yml, que publica
# Postgres, Redis, ChromaDB y Ollama solo en 127.0.0.1.
# Producción usa deploy/env.shared.example. NUNCA commitear .env.
# ============================================================

APP_ENV=development
DEBUG=false
API_DOCS_ENABLED=true          # /docs y /openapi.json; en producción va en false
LOG_LEVEL=INFO

# ── Datos ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pdet_user:REPLACE_ME@localhost:5432/phishing_detector
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8001             # el compose publica el 8000 del contenedor en el 8001

# ── Auth ────────────────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME
JWT_SECRET_KEY=REPLACE_ME
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=1440
# En http://localhost el navegador descarta cookies Secure con SameSite=None.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Orígenes exactos en JSON: el arranque falla si hay comodines.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://hpcgpdffecpcljmofigneicgkdfhplhf"]

# ── MFA y correo saliente (Resend) ──────────────────────────────────────────
# El OTP solo llega por correo. Con MAIL_DRY_RUN=true no se envía nada, así
# que MFA debe quedar apagado; para probarlo, cargar RESEND_API_KEY y poner
# MAIL_DRY_RUN=false y MFA_ENABLED=true.
MFA_ENABLED=false
MAIL_DRY_RUN=true
RESEND_API_KEY=
MAIL_FROM="Detector IDN <alertas@detectoridn.xyz>"
ALERTS_ENABLED=true
DASHBOARD_URL=http://localhost:3000

# ── Cifrado de campos forenses (AES-256-GCM) ────────────────────────────────
# Sin llave, la IP de origen, el Message-ID y los encabezados no se guardan.
# python3 -c "import os,base64,json;print(json.dumps({'k1':base64.b64encode(os.urandom(32)).decode()}))"
FIELD_ENC_KEYS=
FIELD_ENC_ACTIVE=k1

# ── Privacidad (Ley 1581/2012) ──────────────────────────────────────────────
STORE_EMAIL_CONTENT=false      # el cuerpo del correo no se persiste
EMAIL_METADATA_RETENTION_DAYS=30

# ── LLM Gateway remoto (OpenAI-compatible) ──────────────────────────────────
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=REPLACE_ME
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_MODEL_FALLBACK=deepseek-v4-flash
LLM_PROVIDER=opencode-go
LLM_REDACT_PROMPT=true         # redacta PII antes de enviar el prompt

# ── Embeddings del RAG ──────────────────────────────────────────────────────
EMBED_PROVIDER=ollama
EMBED_MODEL=embeddinggemma
EMBED_BASE_URL=http://localhost:11434

# ── Threat Intelligence y modelos de HuggingFace ────────────────────────────
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
WHOISXML_API_KEY=
HUGGINGFACE_API_KEY=

# ── IDN Agent ───────────────────────────────────────────────────────────────
TOP1M_PATH=data/top1m.txt
CONFUSABLES_PATH=data/confusables.txt
TOP1M_LIMIT=150000             # el índice completo tarda ~8 min en construirse en CPU

# ── Geolocalización del servidor de origen (DB-IP Lite, CC BY 4.0) ──────────
# python scripts/fetch_geoip.py   (descarga a data/geoip; la imagen Docker ya las trae)
GEOIP_CITY_DB=data/geoip/dbip-city-lite.mmdb
GEOIP_ASN_DB=data/geoip/dbip-asn-lite.mmdb
