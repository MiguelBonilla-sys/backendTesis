# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=False
CORS_ORIGINS=["http://localhost:5173","chrome-extension://*"]

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/phishing_detector

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# ── LlamaStack ────────────────────────────────────────────────────────────────
LLAMASTACK_URL=http://localhost:5000
LLAMASTACK_MODEL=Llama-3.1-8B-Instruct-GGUF

# ── TI API Keys (leave empty to skip that source) ────────────────────────────
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
WHOISXML_API_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-use-strong-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
