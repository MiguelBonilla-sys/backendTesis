# Config de las dos instancias del backend + del cron de sincronización.
#   - primario  : Coolify (back-tesi.mangel.dpdns.org) — DBs LOCALES, autoritativo
#   - secundario: Render  (render.yaml)                — apunta a la capa free-tier
#   - sync      : deploy/sync-standby.sh en el host de Coolify (cron)
# Valores reales: en el .env local (gitignored) y en el panel de cada plataforma.

# --- DATOS: el PRIMARIO usa los locales del compose; el SECUNDARIO usa estos ---
DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
REDIS_URL=redis://default:<pass>@<host>.cloud.redislabs.com:<port>
CHROMADB_HOST=api.trychroma.com
CHROMADB_PORT=443
CHROMA_API_KEY=ck-<...>
CHROMA_TENANT=<uuid>
CHROMA_DATABASE=<name>

# --- SYNC: entorno del cron deploy/sync-standby.sh (host de Coolify) ---
# APP_UUID=<uuid del recurso Coolify>
# STANDBY_DATABASE_URL=postgresql://<user>:<pass>@<host>.<region>.aws.neon.tech/<db>?sslmode=require   (libpq, endpoint DIRECTO sin -pooler — el sync hace TRUNCATE+COPY)
# STANDBY_CHROMA_HOST=api.trychroma.com
# STANDBY_CHROMA_PORT=443
# STANDBY_CHROMA_API_KEY=ck-<...>
# STANDBY_CHROMA_TENANT=<uuid>
# STANDBY_CHROMA_DATABASE=<name>
# STANDBY_EMBED_MODEL=google/embeddinggemma-300m                 (re-embed del corpus con HF)
# STANDBY_EMBED_BASE_URL=https://router.huggingface.co/hf-inference/models
# STANDBY_EMBED_API_KEY=hf_<...>
# STANDBY_EMBED_PROVIDER=hf   (default si hay STANDBY_EMBED_MODEL)

# --- Auth: MISMO valor en las dos instancias o los JWT no cruzan al conmutar ---
#   generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<token>
JWT_SECRET_KEY=<token>

# --- LLM gateway (remoto — mismo en ambas) ---
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-<...>
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_MODEL_FALLBACK=deepseek-v4-flash
LLM_PROVIDER=opencode-go
LLM_REDACT_PROMPT=true

# --- Threat Intelligence (mismas keys en ambas) ---
HUGGINGFACE_API_KEY=hf_<...>
VIRUSTOTAL_API_KEY=<...>
URLSCAN_API_KEY=<...>
GOOGLE_SAFE_BROWSING_API_KEY=<...>
WHOISXML_API_KEY=<...>

# --- RAG embeddings: mismo MODELO (embeddinggemma-300m, 768d), distinto PROVIDER ---
#   Coolify (primario): EMBED_PROVIDER=ollama  → embeddinggemma por el Ollama local
#                       EMBED_BASE_URL=http://ollama:11434  (servicio del compose)
#   Render  (standby) : EMBED_PROVIDER=hf      → mismo modelo vía HuggingFace Inference
#                       EMBED_BASE_URL=https://router.huggingface.co/hf-inference/models
#                       EMBED_API_KEY=hf_<...>   EMBED_AUTH_SCHEME=Bearer
#   El sync (deploy/sync-standby.sh) RE-EMBEBE con HF al copiar, porque Ollama-GGUF
#   y HF-fp del mismo embeddinggemma dan vectores distintos (cos ~0.6). No copiar
#   vectores entre stacks. fal.run NO tiene embeddinggemma; fallback documentado:
#   EMBED_PROVIDER=openai + fal baai/bge-m3 (1024d) en Render (re-seed de Chroma Cloud).
EMBED_PROVIDER=hf
EMBED_MODEL=google/embeddinggemma-300m
EMBED_BASE_URL=https://router.huggingface.co/hf-inference/models
EMBED_API_KEY=hf_<...>            # HUGGINGFACE_API_KEY
EMBED_AUTH_SCHEME=Bearer

# --- Por instancia (mismo criterio, valor propio de cada una) ---
# CORS_ORIGINS  JSON con los orígenes del front y la extensión: ["https://<front>","chrome-extension://<id>"]
# TOP1M_LIMIT   150000 en ambas; subir según RAM
