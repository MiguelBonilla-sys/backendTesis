[Unit]
Description=BackendTesis Ngrok Tunnel Launcher
After=network.target

[Service]
Type=simple
User=mangel
Group=mangel
WorkingDirectory=/home/mangel/Documentos/devs/backendTesis
ExecStart=/usr/bin/python3 /home/mangel/Documentos/devs/backendTesis/scripts/launch_ngrok.py
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=backendtesis-ngrok

[Install]
WantedBy=multi-user.target
